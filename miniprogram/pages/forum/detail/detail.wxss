/* ==================== 论坛头 ==================== */
.forum-header {
  margin-bottom: 24rpx;
  animation: cardSlide 0.35s ease both;
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--bg-card) 100%);
  border-radius: var(--radius-lg);
}

.forum-header-top {
  display: flex;
  align-items: center;
}

.forum-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.forum-cover image {
  width: 100%;
  height: 100%;
}

.forum-cover-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-lg);
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  font-size: 64rpx;
}

.forum-info {
  flex: 1;
}

.forum-name {
  font-size: var(--font-size-lg);
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
  color: var(--text);
}

.forum-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.forum-members {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.join-action {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.join-btn {
  font-size: var(--font-size-md) !important;
  background: var(--brand);
  color: var(--text-inverse) !important;
  border-radius: var(--radius-pill);
  padding: 12rpx 48rpx;
  line-height: 1.5;
  transition: all 0.2s;
  box-shadow: 0 4rpx 12rpx rgba(0, 181, 120, 0.2);
}

.join-btn:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.join-btn.joined {
  background: var(--border-strong);
  color: var(--text-secondary) !important;
  box-shadow: none;
}

/* ==================== 帖子卡片 ==================== */
.post-item {
  margin-bottom: 24rpx;
  animation: cardSlide 0.3s ease both;
}

.post-author {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--border);
  border: 2rpx solid var(--border);
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text);
}

.post-time {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.post-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
  color: var(--text);
}

.post-content {
  font-size: var(--font-size-base);
  color: var(--text);
  line-height: 1.6;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 8rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
}

.post-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.action-item {
  margin-right: 40rpx;
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  padding: 8rpx 0;
  transition: color 0.2s;
}

.action-item:active {
  transform: scale(0.95);
}

.action-item .liked {
  color: var(--danger);
}

.loading-more,
.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}
