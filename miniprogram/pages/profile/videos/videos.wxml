<view class="container">
  <view class="video-list">
    <block wx:for="{{videos}}" wx:key="_id">
      <view class="video-card card" bindtap="goDetail" data-id="{{item._id}}" bindlongpress="deleteVideo">
        <view class="video-cover">
          <image wx:if="{{item.coverImage}}" class="cover-img" src="{{item.coverImage}}" mode="aspectFill" />
          <view wx:else class="cover-placeholder">🎬</view>
          <text class="duration" wx:if="{{item.duration}}">{{item.duration}}"</text>
        </view>
        <view class="video-info">
          <text class="video-title">{{item.title || '无标题'}}</text>
          <text class="video-desc">{{item.description || ''}}</text>
          <view class="video-meta">
            <text>{{item.likeCount || 0}} 赞</text>
            <text>{{item.commentCount || 0}} 评论</text>
          </view>
        </view>
      </view>
    </block>

    <view class="empty" wx:if="{{!loading && videos.length === 0}}">
      <text class="empty-icon">🎬</text>
      <text class="empty-text">还没有上传视频</text>
      <text class="empty-hint">去发布页面分享你的精彩瞬间</text>
    </view>

    <view class="load-more" wx:if="{{loading}}">
      <text>正在加载...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore && videos.length > 0}}">
      <text class="no-more">— 没有更多了 —</text>
    </view>
  </view>
</view>
