<view class="container">
  <!-- 帖子内容 -->
  <view class="card" wx:if="{{post}}">
    <view class="post-header">
      <image class="avatar" src="{{post.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="header-info">
        <text class="author-name">{{post.nickName || '球友'}}</text>
        <text class="post-time">{{post.createdAt}}</text>
      </view>
      <view wx:if="{{post.openid === currentOpenid}}" class="delete-btn" bindtap="deletePost">
        <text>🗑️</text>
      </view>
    </view>

    <text class="post-title">{{post.title}}</text>
    <text class="post-content">{{post.content}}</text>

    <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
      <image
        wx:for="{{post.images}}"
        wx:key="*this"
        wx:for-item="img"
        src="{{img}}"
        mode="aspectFill"
        class="post-image"
        data-src="{{img}}"
        bindtap="previewImage"
      />
    </view>

    <view class="post-actions">
      <view class="action-item" bindtap="toggleLike">
        <text class="{{post._liked ? 'liked' : ''}}">{{post._liked ? '❤️' : '🤍'}} {{post.likeCount || 0}}</text>
      </view>
      <view class="action-item">
        <text>💬 {{post.commentCount || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 评论列表 -->
  <view class="comments-section">
    <text class="section-title">评论 ({{comments.length}})</text>

    <view wx:if="{{comments.length > 0}}">
      <view wx:for="{{comments}}" wx:key="_id" class="card comment-item">
        <view class="comment-header">
          <image class="avatar-sm" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="comment-info">
            <text class="comment-author">{{item.nickName || '球友'}}</text>
            <text class="comment-time">{{item.createdAt}}</text>
          </view>
          <view
            wx:if="{{item.openid === currentOpenid}}"
            class="delete-btn"
            data-id="{{item._id}}"
            bindtap="deleteComment"
          >
            <text>🗑️</text>
          </view>
        </view>
        <text class="comment-content">{{item.content}}</text>
      </view>
    </view>

    <view wx:else class="empty-comments">
      <text>暂无评论，来说两句吧</text>
    </view>
  </view>

  <!-- 底部评论输入 -->
  <view class="comment-bar">
    <input
      class="comment-input"
      placeholder="写评论..."
      value="{{commentText}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="sendComment"
    />
    <button class="send-btn" bindtap="sendComment" disabled="{{sending}}">发送</button>
  </view>
</view>
