/* ==================== 设计令牌 Design Tokens ==================== */
page {
  /* 品牌色 */
  --brand: #00B578;
  --brand-light: #E6F7F0;
  --brand-dark: #009A64;
  --accent: #FF6B35;

  /* 状态色 */
  --success: #52C41A;
  --warning: #FAAD14;
  --danger: #FF4D4F;

  /* 原色保留兼容 */
  --green: #00B578;
  --green-light: #E6F7F0;
  --green-dark: #009A64;
  --red: #e74c3c;
  --yellow: #f39c12;
  --white: #ffffff;

  /* 文字 */
  --text: #1A1A1A;
  --text-secondary: #8C8C8C;
  --text-tertiary: #BFBFBF;
  --text-disabled: #D9D9D9;
  --text-inverse: #FFFFFF;

  /* 背景 */
  --bg: #F0F1F5;
  --bg-card: #FFFFFF;
  --bg-mask: rgba(0, 0, 0, 0.5);

  /* 边框 */
  --border: #EEEEEE;
  --border-strong: #D9D9D9;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-pill: 999rpx;

  /* 字体尺寸 */
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 30rpx;
  --font-size-lg: 34rpx;
  --font-size-xl: 40rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: var(--font-size-base);
  color: var(--text);
  background-color: var(--bg);
  box-sizing: border-box;
}

/* ==================== 重置 ==================== */
view, text, button, image, input, scroll-view {
  box-sizing: border-box;
}

button::after { border: none; }

/* ==================== 通用容器 ==================== */
.container {
  padding: 32rpx 24rpx;
}

/* ==================== 卡片 ==================== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-pressable {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-pressable:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* ==================== 按钮 ==================== */
.btn-primary {
  background-color: var(--brand);
  color: var(--text-inverse);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  padding: 20rpx 48rpx;
  border: none;
  transition: opacity 0.15s, transform 0.15s;
  box-shadow: 0 4rpx 12rpx rgba(0, 181, 120, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-danger {
  background-color: var(--danger);
  color: var(--text-inverse);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  padding: 20rpx 48rpx;
  border: none;
  transition: opacity 0.15s, transform 0.15s;
}

.btn-danger:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-default {
  background-color: var(--bg-card);
  color: var(--text);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  padding: 20rpx 48rpx;
  border: 2rpx solid var(--border-strong);
  transition: opacity 0.15s, transform 0.15s;
}

.btn-default:active {
  opacity: 0.7;
  transform: scale(0.98);
}

/* ==================== 标签 ==================== */
.tag {
  display: inline-block;
  font-size: var(--font-size-xs);
  color: var(--brand);
  background: var(--brand-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-right: 8rpx;
  line-height: 1.5;
}

.tag-success {
  color: var(--success);
  background: #F6FFED;
}

.tag-warning {
  color: var(--warning);
  background: #FFF7E6;
}

.tag-danger {
  color: var(--danger);
  background: #FFF1F0;
}

/* ==================== 区块标题 ==================== */
.section-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text);
  padding: 24rpx 0 16rpx 0;
  display: block;
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: var(--brand);
  border-radius: var(--radius-pill);
}

/* ==================== 列表项 ==================== */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: none;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--text-secondary);
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-title {
  font-size: var(--font-size-md);
  color: var(--text);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

/* ==================== 骨架屏 ==================== */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: var(--radius-sm);
  animation: skeleton-shimmer 1.5s infinite;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ==================== 动画 ==================== */
.page-fade {
  animation: pageFade 0.3s ease both;
}

@keyframes pageFade {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-slide {
  animation: cardSlide 0.35s ease both;
}

@keyframes cardSlide {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== FAB 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 128rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 181, 120, 0.4);
  z-index: 100;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fab:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(0, 181, 120, 0.3);
}

.fab-text {
  font-size: 48rpx;
  color: var(--text-inverse);
  line-height: 1;
}
