/* ==================== 页面骨架 ==================== */
.container {
  padding: 24rpx 0;
  animation: pageFade 0.3s ease both;
}

/* ==================== 分类筛选 ==================== */
.category-bar {
  white-space: nowrap;
  padding: 16rpx 0;
  background: var(--bg-card);
  margin: 0 24rpx 16rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.categories {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.cat-item {
  flex-shrink: 0;
  font-size: var(--font-size-sm);
  padding: 12rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--bg);
  color: var(--text-secondary);
  transition: all 0.2s ease;
}
.cat-item.active {
  background: var(--brand);
  color: var(--white);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 181, 120, 0.3);
}

/* ==================== 列表 ==================== */
.article-list {
  padding: 0 24rpx;
}

.article-card {
  display: flex;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  animation: cardSlide 0.3s ease both;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.article-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  margin-right: 20rpx;
  background: var(--bg);
}
.cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: var(--brand-light);
}

.article-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  min-width: 0;
}

.title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.category-tag {
  font-size: var(--font-size-xs);
  color: var(--brand);
  background: var(--brand-light);
  align-self: flex-start;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  margin-top: 8rpx;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.views {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.source {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== 空状态 / 加载更多 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
}

.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.no-more {
  color: var(--text-tertiary);
}
