/* ==================== 页面骨架 ==================== */
.container {
  animation: pageFade 0.3s ease both;
}

/* ==================== 视频网格（2 列卡片） ==================== */
.video-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 8rpx 24rpx;
}

.video-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin: 0;
  box-shadow: var(--shadow-sm);
  animation: cardSlide 0.3s ease both;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.video-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}
.video-card:nth-child(2n) {
  animation-delay: 0.05s;
}
.video-card:nth-child(3n) {
  animation-delay: 0.1s;
}

/* ==================== 封面 ==================== */
.video-cover {
  position: relative;
  width: 100%;
  height: 170rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  margin-bottom: 14rpx;
  background: var(--bg);
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: var(--brand-light);
}

.duration {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  font-size: var(--font-size-xs);
  color: var(--white);
  background: rgba(0, 0, 0, 0.6);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
}

/* ==================== 视频信息 ==================== */
.video-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.video-title {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-desc {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8rpx;
}

.video-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.video-meta text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

/* ==================== 空状态 / 加载更多 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  grid-column: 1 / -1;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  grid-column: 1 / -1;
}

.no-more {
  color: var(--text-tertiary);
}
