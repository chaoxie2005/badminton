/* ==================== 页面骨架 ==================== */
.container {
  animation: pageFade 0.3s ease both;
}

/* ==================== 筛选 tab ==================== */
.filter-tabs {
  display: flex;
  margin: 0 24rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  padding: 8rpx;
  box-shadow: var(--shadow-sm);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.tab.active {
  background: var(--brand);
  color: var(--white);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 181, 120, 0.3);
}

/* ==================== 记分牌卡片（完整声明，覆盖全局 .card 外观） ==================== */
.scoreboard-item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  animation: cardSlide 0.3s ease both;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.scoreboard-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}
.scoreboard-item:nth-child(2n) {
  animation-delay: 0.05s;
}

/* ==================== 卡片头部 ==================== */
.board-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.board-name {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-status {
  font-size: var(--font-size-xs);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 600;
  flex-shrink: 0;
}
.board-status.ongoing {
  background: var(--brand-light);
  color: var(--brand);
}
.board-status.finished {
  background: var(--bg);
  color: var(--text-secondary);
}

/* ==================== 比分行 ==================== */
.board-score-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.player-name {
  font-size: var(--font-size-base);
  flex: 2;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text);
}

.score-display {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.score-num {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--brand);
  min-width: 64rpx;
  text-align: center;
  line-height: 1;
}

.score-colon {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
}

/* ==================== 红黄牌 / 时间 ==================== */
.board-cards {
  display: flex;
  gap: 24rpx;
  font-size: var(--font-size-sm);
  margin-top: 12rpx;
}
.board-cards text {
  color: var(--text-secondary);
  font-weight: 600;
}

.board-time {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

/* ==================== 空状态 / 加载更多 ==================== */
.empty-state {
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-size-md);
  color: var(--text);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.empty-btn {
  margin-top: 36rpx;
  padding: 20rpx 56rpx;
  background: var(--brand);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-base);
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(0, 181, 120, 0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.empty-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}

.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.no-more {
  color: var(--text-tertiary);
}
