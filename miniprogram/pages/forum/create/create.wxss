/* 论坛创建页 - 使用统一设计令牌 */
.form-group {
  margin-bottom: 24rpx;
}

.title-input {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

.content-input {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-size-base);
  line-height: 1.8;
  min-height: 300rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
  color: var(--text);
}

.image-picker {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
  display: block;
}

.remove-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(26, 26, 26, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: var(--font-size-sm);
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border-strong);
  border-radius: var(--radius-md);
  background: var(--brand-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.add-icon {
  font-size: 56rpx;
  color: var(--brand);
  line-height: 1;
}

.add-text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.submit-area {
  margin-top: 48rpx;
  text-align: center;
}

.submit-btn {
  width: 100%;
  padding: 24rpx 0;
}

.hint {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}
