/* ==================== 页面骨架 ==================== */
.container {
  animation: pageFade 0.3s ease both;
}

/* ==================== 帖子列表 ==================== */
.post-list {
  padding: 8rpx 0;
}

/* 帖子卡片：与全局 .card 外观一致，叠加 cardSlide 动画与按压效果 */
.post-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  box-shadow: var(--shadow-sm);
  animation: cardSlide 0.3s ease both;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.post-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}
.post-card:nth-child(2n) {
  animation-delay: 0.05s;
}
.post-card:nth-child(3n) {
  animation-delay: 0.1s;
}

/* ==================== 帖子头部 ==================== */
.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.post-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ==================== 帖子正文 ==================== */
.post-content {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ==================== 帖子底部 ==================== */
.post-footer {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.post-footer text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

/* ==================== 空状态 / 加载更多 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.no-more {
  color: var(--text-tertiary);
}
