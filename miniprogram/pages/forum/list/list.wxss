/* 论坛列表页 - 使用统一设计令牌 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-pill);
  padding: 0 32rpx;
  font-size: var(--font-size-base);
  color: var(--text);
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
}

.search-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background: var(--brand);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-sm);
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}

.search-btn:active {
  opacity: 0.85;
}

.forum-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  animation: cardSlide 0.3s ease;
}

.forum-main {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.forum-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.forum-cover image {
  width: 100%;
  height: 100%;
  display: block;
}

.forum-cover-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  font-size: 56rpx;
}

.forum-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.forum-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.forum-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.forum-meta {
  display: flex;
  align-items: center;
}

.forum-members {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  margin-right: 16rpx;
}

.forum-tags {
  display: flex;
}

.tag {
  font-size: var(--font-size-xs);
  color: var(--brand);
  background: var(--brand-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-right: 8rpx;
}

.forum-action {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.join-btn {
  font-size: var(--font-size-sm) !important;
  background: var(--brand);
  color: #fff;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-sm);
}

.join-btn.joined {
  background: var(--border);
  color: var(--text-secondary);
}

.loading-more,
.no-more {
  text-align: center;
  padding: 24rpx;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 181, 120, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.94);
  transition: transform 0.15s ease;
}
