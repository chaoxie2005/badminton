/* ==================== 页面骨架 ==================== */
.container {
  padding: 0 0 48rpx;
  animation: pageFade 0.3s ease both;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  font-size: var(--font-size-base);
  color: var(--text-secondary);
}

.error {
  text-align: center;
  padding: 120rpx 32rpx;
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  background: var(--bg-card);
  margin: 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

/* ==================== 头部 ==================== */
.cover {
  width: 100%;
  height: 400rpx;
  border-radius: 0;
}

.content {
  padding: 32rpx 24rpx;
}

.title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--text);
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.category {
  font-size: var(--font-size-sm);
  color: var(--brand);
  background: var(--brand-light);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-weight: 600;
}

.views {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.source {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* ==================== 正文 ==================== */
.body {
  padding-top: 24rpx;
  font-size: var(--font-size-base);
  line-height: 1.7;
  color: var(--text);
}

.no-content {
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  padding: 48rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
}
